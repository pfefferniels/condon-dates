  {
   "@id": "premises#advance-1mm",
   "company": {
    "name": "M. Welte & Söhne",
    "sameAs": [
     "https://d-nb.info/gnd/5125268-5"
    ]
   },
   "system": {
    "@id": "https://w3id.org/reo/type/system/welte-t100"
   },
   "perforator": {
    "@type": "Perforator",
    "@id": "premises#advance-1mm-perforator",
    "condition": {
     "conditionType": "setting",
     "advance": {
      "value": 1.007,
      "unit": "mm"
     }
    }
   },
   "date": {
    "before": "1910-05-21",
    "@annotation": {
     "@id": "premises#advance-1mm-annotation",
     "belief": {
      "@type": "belief",
      "@id": "premises#advance-1mm-belief",
      "certainty": "likely",
      "reasons": [
       {
        "@type": "inference",
        "premises": [],
        "used": [
         "https://w3id.org/welte-premises/evidence/advance",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/data/readings.json",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/data/perforator.json",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/premises.py",
         "https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/step.py"
        ],
        "note": "The advance resolves, at a strength of at least 0.25, at 0.85 to 1.15 mm on 11 copies dated to the day at high or medium confidence, from 1908-11-20 to 1909-12-16, and under 0.75 mm on 191, from 1910-05-21 to 1928-06-19; no dated copy falls on the wrong side. The perforator was re-set to the late advance by the day of the first late copy, Welte 1211 of 1910-05-21 (https://purl.stanford.edu/tj337qh7786), and the bound rests on that copy's date alone. The early advance resolves on the rolls of three hands only, and on none before 1908, so it is attested on fewer rolls than it was used on (punch-225/dates/README.md)."
       }
      ]
     }
    }
   }
  },
  {
   "@id": "premises#advance-half-mm",
