      "value": 0.5,
      "unit": "mm"
     }
    }
   },
   "date": {
    "after": "1909-12-16",
    "@annotation": {
     "@id": "premises#advance-half-mm-annotation",
     "belief": {
      "@type": "belief",
      "@id": "premises#advance-half-mm-belief",
      "certainty": "likely",
      "reasons": [
       {
        "@type": "inference",
        "premises": [],
        "used": [
         "https://w3id.org/welte-premises/evidence/advance",
         "https://github.com/pfefferniels/condon-dates/blob/f7bd8c9d4e95b46c444efd00959a593aa45100ef/data/readings.json",
         "https://github.com/pfefferniels/condon-dates/blob/f7bd8c9d4e95b46c444efd00959a593aa45100ef/data/perforator.json",
         "https://github.com/pfefferniels/condon-dates/blob/f7bd8c9d4e95b46c444efd00959a593aa45100ef/premises.py",
         "https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/step.py"
        ],
        "note": "The advance resolves, at a strength of at least 0.25, at 0.85 to 1.15 mm on 11 copies dated to the day at high or medium confidence, from 1908-11-20 to 1909-12-16, and under 0.75 mm on 191, from 1910-05-21 to 1928-06-19; no dated copy falls on the wrong side. The perforator was still at the early advance on the day of the last early copy, Welte 569 of 1909-12-16 (https://purl.stanford.edu/rb625rv7300), and the bound rests on that copy's date alone. The rolls before it that do not resolve are not late-advance rolls hiding: a comb at 0.5 mm is the easier of the two to see (punch-225/dates/README.md)."
       }
      ]
     }
    }
   }
  }
 ]
}
