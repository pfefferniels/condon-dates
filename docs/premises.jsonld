    "name": "light cool red paper"
   },
   "date": {
    "after": "1921-10-04",
    "before": "1922-02-23",
    "@annotation": {
     "@id": "premises#paper-red-cool-light-annotation",
     "belief": {
      "@type": "belief",
      "@id": "premises#paper-red-cool-light-belief",
      "certainty": "possible",
      "reasons": [
       {
        "@type": "inference",
        "premises": [],
        "used": [
         "https://w3id.org/welte-premises/evidence/paper",
         "https://w3id.org/welte-premises/papers",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/paper/colour.json",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/paper/colour.py",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/data/readings.json",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/data/perforator.json",
         "https://github.com/pfefferniels/condon-dates/blob/f6ec84ec54d2a4d2ff50c2898cebea36b6a66516/premises.py"
        ],
        "note": "11 rolls measure as light cool red paper (cool red with L* at least 38, corrected CIELAB), 5 of them dated to the day at high or medium confidence, from 1921-10-04 to 1922-02-23. All 11 whose chain pitch is measured were punched on the narrow perforator. The bounds rest on the first and the last dated copy, Welte 2540 of 1921-10-04 (https://purl.stanford.edu/tr243mz6407) and Welte 1773 of 1922-02-23 (https://purl.stanford.edu/ds710xd1794). Its dates lie closer together than chance allows: 0.3 years between the tenth and the ninetieth percentile, against 3.4 years for random groups of as many dated copies of cool red paper, of which 5 in 10000 were as close. Within a unit of the rule's edge lie 3 dated copies; those of 1913-09-20, 1922-10-09, 1923-03-15 lie outside the window and would widen it under a looser rule. The class is attested on 5 dated copies only."
       }
      ]
     }
    }
   }
