edu/bf644yy6536","exemplifies":{"catalogueNumber":"WM 1480","label":"Samaroff Stokowski, Olga (1882-1948): Peer Gynt suite II"},"keeper":{"name":"Stanford University Libraries","sameAs":[]},"conditions":[],"measurements":{"scanResolution":{"value":300.25,"unit":"px/in"},"holeSeparation":{"value":3.2,"unit":"mm"}},"modifications":[{"@type":"Alteration","purpose":"control","produced":[{"@type":"Writing","@id":"copies/bf644yy6536.jsonld#inscription","technique":"handwriting","horizontal":{"unit":"mm","from":16801.05,"to":16961.79},"vertical":{"unit":"track","from":89,"to":103},"depiction":"https://stacks.stanford.edu/image/iiif/bf644yy6536%2Fbf644yy6536_0001/3487,198603,460,1900/full/270/default.jpg","transcription":{"@type":"text","@id":"copies/bf644yy6536.jsonld#inscription-text","text":"1450.  11.[2 or 3].14."}}]}],"scan":"https://stacks.stanford.edu/image/iiif/bf644yy6536%2Fbf644yy6536_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"after":"1914-01-01","before":"1914-12-31","@annotation":{"@id":"copies/bf644yy6536.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/bf644yy6536.jsonld#date-belief","certainty":"possible","reasons":[{"@type":"meaningComprehension","comprehends":["copies/bf644yy6536.jsonld#inscription-text"],"note":"crop 1, lower panel upright, pencil, one line in two groups; crop 2 is a torn roll end with no writing. The writing sits hard against the top edge of the crop, so the upper third of every figure is cut off, in both panels alike. Group 1 reads 1450. and is taken as the roll number. Group 2 is 11 . X . 14 .: the day 11 and the year 14 are firm, the month figure is a thick stroke with a base sweeping right, either a 2 or a 3, and the clipped top is exactly what would tell them apart. Day and year alone give 1914; the month is left open rather than guessed."}]}}},"perforator":{"@type":"Perforator","@id":"copies/