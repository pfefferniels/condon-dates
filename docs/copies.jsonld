hands.jsonld"],"note":"The signature is clustered with the hand's other rolls by comparing the inscription images, not by the name read."}]}}}}],"scan":"https://stacks.stanford.edu/image/iiif/sc188ff2842%2Fsc188ff2842_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"within":"1911-07-21","@annotation":{"@id":"copies/sc188ff2842.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/sc188ff2842.jsonld#date-belief","certainty":"true","reasons":[{"@type":"meaningComprehension","comprehends":["copies/sc188ff2842.jsonld#inscription-text"],"note":"Ink, the number at the left, the date in the middle, Krämer at the right with the umlaut stroke plain and Wössler written under it. The same two names and the same hand as wp442mf3514 in batch 14, which carries 25. 4. 11. The month figure is the crossbarred 7 of this hand, not the H-shaped 4 it writes elsewhere, and the year is two separate 1 strokes."}]}}},"perforator":{"@type":"Perforator","@id":"copies/sc188ff2842.jsonld#perforator","condition":{"conditionType":"setting","punchDiameter":{"value":2.191,"unit":"mm","@annotation":{"@id":"copies/sc188ff2842.jsonld#punch-diameter-annotation","belief":{"@type":"belief","@id":"copies/sc188ff2842.jsonld#punch-diameter-belief","certainty":"possible","reasons":[{"@type":"measurement","note":"AVG_HOLE_WIDTH of the roll's SUPRA analysis: the parser's box at its own grey level, averaged over every perforation it kept, so that a tear or a run of dust drags it. On the three copies measured both ways, an edge at half the contrast put the punch 0.10 to 0.15 mm wider (punch-225/README.md).","used":["https://raw.githubusercontent.com/pianoroll/piano-roll-analyses/main/analysis/s/sc188ff2842_analysis.txt.bz2","https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/pitch.py"]}]}}},"chainPitch":{"value":2.9807,"unit":"