tions":[{"@type":"Alteration","purpose":"control","produced":[{"@type":"Writing","@id":"copies/wj488tq5861.jsonld#inscription","technique":"handwriting","horizontal":{"unit":"mm","from":28828.6,"to":28989.33},"vertical":{"unit":"track","from":90,"to":103},"depiction":"https://stacks.stanford.edu/image/iiif/wj488tq5861%2Fwj488tq5861_0001/3514,340779,460,1900/full/90/default.jpg","transcription":{"@type":"text","@id":"copies/wj488tq5861.jsonld#inscription-text","text":"22. 6 09. Hohmüller"}}],"actor":{"name":"Hohnrieder","sameAs":[],"@id":"hands.jsonld#hohnrieder","@annotation":{"@id":"copies/wj488tq5861.jsonld#hand-annotation","belief":{"@type":"belief","@id":"copies/wj488tq5861.jsonld#hand-belief","certainty":"likely","reasons":[{"@type":"meaningComprehension","comprehends":["copies/wj488tq5861.jsonld#inscription-text"],"note":"Read as \"Hohmüller\"."},{"@type":"inference","premises":[],"used":["https://pfefferniels.github.io/condon-dates/hands.jsonld"],"note":"The signature is clustered with the hand's other rolls by comparing the inscription images, not by the name read."}]}}}}],"scan":"https://stacks.stanford.edu/image/iiif/wj488tq5861%2Fwj488tq5861_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"within":"1909-06-22","@annotation":{"@id":"copies/wj488tq5861.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/wj488tq5861.jsonld#date-belief","certainty":"likely","reasons":[{"@type":"meaningComprehension","comprehends":["copies/wj488tq5861.jsonld#inscription-text"],"note":"Fine pencil, one line on the upper (upright) panel, no roll number. The month 6 and the year 09 are plain. The day is two identical glyphs run together, each a curve over the top and a diagonal down to a curled base, which I read as 22; a reading of 77 would fit the strokes less well, since this hand crosses its sevens. The name is written fast but has the same shape as the Hohmüller on gs573tj9547 in this batch, which is how I read it here."}]}}},"perforator":{"@type":"Perforator","@id":"copies/wj488tq5861.jsonld#perforator","condition":{"conditionType":"setting","punchDiameter":{"value":2.2249,"unit":"mm","@annotation":{"@id":"copies/wj488tq5861.jsonld#punch-diameter-annotation","belief":{"@type":"belief","@id":"copies/wj488tq5861.jsonld#punch-diameter-belief","certainty":"possible","reasons":[{"@type":"measurement","note":"AVG_HOLE_WIDTH of the roll's SUPRA analysis: the parser's box at its own grey level, averaged over every perforation it kept, so that a tear or a run of dust drags it. On the three copies measured both ways, an edge at half the contrast put the punch 0.10 to 0.15 mm wider (punch-225/README.md).","used":["https://raw.githubusercontent.com/pianoroll/piano-roll-analyses/main/analysis/w/wj488tq5861_analysis.txt.bz2","https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/pitch.py"]}]}}},"chainPitch":{"value":2.9908,"unit":"mm","slot":2.3175,"bridge":0.665,"n":233,"@annotation":{"@id":"copies/wj488tq5861.jsonld#chain-pitch-annotation","belief":{"@type":"belief","@id":"copies/wj488tq5861.jsonld#chain-pitch-belief","certainty":"likely","reasons":[{"@type":"measurement","note":"Median over 233 pitches of held notes, measured on the IIIF image by punch-225/dates/pitch.py; slot and bridge are medians of their own.","used":["https://stacks.stanford.edu/image/iiif/wj488tq5861%2Fwj488tq5861_0001/","https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/pitch.py"]}]}}},"advance":{"value":0.919,"unit":"mm","strength":0.1059,"n":19720,"@annotation":{"@id":"copies/wj488tq5861.jsonld#advance-annotation","belief":{"@type":"belief","@id":"copies/wj488tq5861.jsonld#advance-belief","certainty":"unlikely","reasons":[{"@type":"measurement","note":"The strongest period the 19720 slot lengths keep, by punch-225/advance.py (punc