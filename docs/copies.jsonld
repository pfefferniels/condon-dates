15.jsonld#copy","label":"Condon Roll 647","identifier":"Stanford Libraries CONDON ROLL 647","seeAlso":"https://purl.stanford.edu/pc364sy7115","exemplifies":{"catalogueNumber":"WM 2609","label":"Goodall, B: Graf von Luxemburg : Selektion I"},"keeper":{"name":"Stanford University Libraries","sameAs":[]},"conditions":[],"measurements":{"scanResolution":{"value":300.25,"unit":"px/in"},"holeSeparation":{"value":3.1936,"unit":"mm"}},"modifications":[{"@type":"Alteration","purpose":"control","produced":[{"@type":"Writing","@id":"copies/pc364sy7115.jsonld#inscription","technique":"handwriting","horizontal":{"unit":"mm","from":40720.7,"to":40881.44},"vertical":{"unit":"track","from":82,"to":103},"depiction":"https://stacks.stanford.edu/image/iiif/pc364sy7115%2Fpc364sy7115_0001/3222,481354,721,1900/full/90/default.jpg","transcription":{"@type":"text","@id":"copies/pc364sy7115.jsonld#inscription-text","text":"2609. 19.9. 17."},"medium":"pencil"}]}],"scan":"https://stacks.stanford.edu/image/iiif/pc364sy7115%2Fpc364sy7115_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"within":"1917-09-19","@annotation":{"@id":"copies/pc364sy7115.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/pc364sy7115.jsonld#date-belief","certainty":"likely","reasons":[{"@type":"meaningComprehension","comprehends":["copies/pc364sy7115.jsonld#inscription-text"],"note":"pencil, written along the roll; read from the upper panel rotated a quarter turn. Day and month plain: both 9s are a small closed bowl over a straight descender, no apex or crossbar, so 19.9 and not 14.4. The year pair is thinner and slightly rubbed, but the second figure carries a horizontal top bar, hence 17. The fourth figure of the number descends below the line, so 2609 and not 2600."}]}}},"perforator":{"@type":"Perforator","@id":"copies/pc364sy7115.jsonld#perforator","condition":{"conditionType":"setti