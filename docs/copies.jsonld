rength of at least 0.35 with the pitch within 0.15 of a whole number of it, possible when one of the two holds, unlikely when neither does.","used":["https://raw.githubusercontent.com/pianoroll/piano-roll-analyses/main/analysis/b/bf644yy6536_analysis.txt.bz2","https://github.com/pfefferniels/welte225.org/blob/0f6bcfb85154f3d2c2928049b7518463fad1d1c9/punch-225/dates/step.py"]}]}}}}}}},{"@type":"RollCopy","@id":"copies/vz717bq6543.jsonld#copy","label":"Condon Roll 483","identifier":"Stanford Libraries CONDON ROLL 483","seeAlso":"https://purl.stanford.edu/vz717bq6543","exemplifies":{"catalogueNumber":"WM 1480","label":"Samaroff Stokowski, Olga (1882-1948): Peer Gynt suite"},"keeper":{"name":"Stanford University Libraries","sameAs":[]},"conditions":[],"measurements":{"scanResolution":{"value":300.25,"unit":"px/in"},"holeSeparation":{"value":3.1922,"unit":"mm"}},"modifications":[{"@type":"Alteration","purpose":"control","produced":[{"@type":"Writing","@id":"copies/vz717bq6543.jsonld#inscription","technique":"handwriting","horizontal":{"unit":"mm","from":16804.52,"to":16965.25},"vertical":{"unit":"track","from":90,"to":103},"depiction":"https://stacks.stanford.edu/image/iiif/vz717bq6543%2Fvz717bq6543_0001/3504,198644,460,1900/full/270/default.jpg","transcription":{"@type":"text","@id":"copies/vz717bq6543.jsonld#inscription-text","text":"19814"}}]}],"scan":"https://stacks.stanford.edu/image/iiif/vz717bq6543%2Fvz717bq6543_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"within":"1914-08-19","@annotation":{"@id":"copies/vz717bq6543.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/vz717bq6543.jsonld#date-belief","certainty":"true","reasons":[{"@type":"meaningComprehension","comprehends":["copies/vz717bq6543.jsonld#inscription-text"],"note":"crop 1, lower panel upright; pencil, nothing else in the crop. Five figures, no separators: 1 9 8 1 4.