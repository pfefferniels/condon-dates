]},"conditions":[],"measurements":{"scanResolution":{"value":300.25,"unit":"px/in"},"holeSeparation":{"value":3.1947,"unit":"mm"}},"modifications":[{"@type":"Alteration","purpose":"control","produced":[{"@type":"Writing","@id":"copies/dq126tp4234.jsonld#inscription","technique":"handwriting","horizontal":{"unit":"mm","from":20430.65,"to":20591.38},"vertical":{"unit":"track","from":89,"to":102},"depiction":"https://stacks.stanford.edu/image/iiif/dq126tp4234%2Fdq126tp4234_0001/3473,241508,460,1900/full/90/default.jpg","transcription":{"@type":"text","@id":"copies/dq126tp4234.jsonld#inscription-text","text":"2[?] 10 22"},"medium":"pencil"}]}],"scan":"https://stacks.stanford.edu/image/iiif/dq126tp4234%2Fdq126tp4234_0001/","readFrom":{"kind":"scan"},"production":{"company":{"name":"M. Welte & Söhne","sameAs":[]},"system":{"@id":"https://w3id.org/reo/type/system/welte-t100"},"date":{"after":"1922-10-01","before":"1922-10-31","@annotation":{"@id":"copies/dq126tp4234.jsonld#date-annotation","belief":{"@type":"belief","@id":"copies/dq126tp4234.jsonld#date-belief","certainty":"possible","reasons":[{"@type":"meaningComprehension","comprehends":["copies/dq126tp4234.jsonld#inscription-text"],"note":"Pencil, treble edge. Six figures grouped 2 + 2 + 2, all of them cut along the top by the crop edge, which begins at the first row of ink. The last two are the same figure, a hooked top with a diagonal and a base, giving the year 22; the middle pair are a plain diagonal and an oval, giving the month 10; the first is a 2. The second figure shows two lobes and looks like the open-topped 8, which would make the day 28, but it is not legible enough to fix and I have not completed it. Crops 2 to 4 carry only a repair patch and stains."}]}}},"perforator":{"@type":"Perforator","@id":"copies/dq126tp4234.jsonld#perforator","condition":{"conditionType":"setting","punchDiameter":{"value":1.7334,"unit":"mm","@annotation":{"@id":"copies/dq126tp4234.jsonld#punch-diameter-annotation","belief":{"@typ