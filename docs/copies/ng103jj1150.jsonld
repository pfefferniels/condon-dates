        "text": "5700.  4. 9. 13.",
        "@annotation": {
         "@id": "copies/ng103jj1150#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/ng103jj1150#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/ng103jj1150#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. The date is restored, having been withdrawn here earlier. Three readers gave 4.9.13 and one found the year cut; read again with the crop lengthened along the roll rather than widened across it, the line is whole. The month carries a descender, so 9 and not 8, and the year's second figure is a rounded double bowl plainly unlike the flat-topped 5 that opens the number 5700 a few centimetres away, so 3. What defeated the earlier crops was their length, not their width."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/ng103jj1150%2Fng103jj1150_0001/",
