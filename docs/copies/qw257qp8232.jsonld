     "@annotation": {
      "@id": "copies/qw257qp8232.jsonld#date-annotation",
      "belief": {
       "@type": "belief",
       "@id": "copies/qw257qp8232.jsonld#date-belief",
       "certainty": "true",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/qw257qp8232.jsonld#inscription-text"
         ],
         "note": "Stamped across the roll in e1, reading along the paper: a heavy fixed mark of stacked bars, a hyphen, then 5 6 2 8, all four figures cleanly inked. The mark is the slug's own, not a digit - the figures alone already give a possible date, so I have not let it make the day 15. Day first gives 5 June 1928. e2 carries 690 in pencil, and the leader label in e3 reads 'WELTE-MIGNON No. 690, Symphonische Etude, Schumann, Gespielt von' with Otto Neitzel's signature, M. Welte & Söhne, Freiburg i. Br., so the roll number is certain and the hand is the German workshop's."
        }
       ]
      }
     }
    },
