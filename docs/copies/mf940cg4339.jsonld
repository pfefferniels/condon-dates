       "transcription": {
        "@type": "text",
        "@id": "copies/mf940cg4339#inscription-text",
        "text": "1468.  23. 4. 07.  [cursive signature, not read]",
        "@annotation": {
         "@id": "copies/mf940cg4339#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/mf940cg4339#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/mf940cg4339#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, upper panel upright, in the same hand, layout and signature as rp146dk0477 (1352, 4.3.07) and cp145vd3423 (1382, 20.1.07). Day and month are plain; the year is the same small 0 run into a crossed 7 that those two carry, followed by a short dash, so the reading is called medium rather than high. The signature after the date I could not read."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ],
     "actor": {
      "name": "B. Schäfer",
      "sameAs": [],
