       "transcription": {
        "@type": "text",
        "@id": "copies/qg121rz6125#inscription-text",
        "text": "1259  [name, illegible]  10 [month word, illegible] 09.",
        "@annotation": {
         "@id": "copies/qg121rz6125#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/qg121rz6125#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/qg121rz6125#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Faint pencil in a Kurrent hand on paper ruled with the scanner's lines, which cross the writing. Five tokens: the number 1259, a word of five or six letters with a long bar over the middle of it, the day 10, a four-letter word, and the year 09 with a full stop. The number, the day and the year are firm. The month is written out rather than in figures and I cannot read it: its letter pattern is tall, short, tall, short, which fits Febr as well as Juli, and the initial is a looped ascender with a descender that could be either F or J. The name after the number is likewise beyond me; the bar over it is the Kurrent mark for a doubled m or n. I give the year alone in date_iso rather than guess a month."
           }
          ]
         }
        }
       }
      }
     ],
     "actor": {
      "name": "Fritz",
      "sameAs": [],
      "@id": "hands#fritz",
      "@annotation": {
       "@id": "copies/qg121rz6125#hand-annotation",
       "belief": {
        "@type": "belief",
        "@id": "copies/qg121rz6125#hand-belief",
        "certainty": "likely",
        "reasons": [
         {
          "@type": "meaningComprehension",
          "comprehends": [
           "copies/qg121rz6125#inscription-text"
          ],
          "note": "Read as \"Fritz\". The ornate F, unmistakable beside roll 225's; the reader recorded it as an illegible name."
         },
         {
          "@type": "inference",
          "premises": [],
          "used": [
