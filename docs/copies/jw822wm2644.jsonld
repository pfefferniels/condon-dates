            "comprehends": [
             "copies/jw822wm2644#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Read here at magnification. This copy has the old pitch, 3.004 mm, at a date seven months before the 1922 control's 2.496 mm, and is one of the two rolls that show the two perforators running side by side."
           }
          ]
         }
        }
       }
      }
