    "date": {
     "within": "1908-10-22",
     "@annotation": {
      "@id": "copies/xk500gs5691.jsonld#date-annotation",
      "belief": {
       "@type": "belief",
       "@id": "copies/xk500gs5691.jsonld#date-belief",
       "certainty": "possible",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/xk500gs5691.jsonld#inscription-text"
         ],
         "note": "Faint pencil. '22' is plain and the last figure is an 8, so 1908 is safe; the middle is either '10' with a single-figure year 8 (22 October 1908) or a month '1' with the year '08' (22 January 1908). I read the marks as '10' then '8' from their spacing, but the other reading is possible. The flourished signature that follows may be Schäfer. Crop 3 shows the leader label 'No. 337 / Berliner Luft / Marsch / P. Lincke / Gespielt von Albrecht Kupfernagel / 4. IV. 05.' — that printed date belongs to the label, not to the punching."
        }
       ]
      }
     }
    },
