          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/yn137rt9938#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, one line on the upper (upright) panel. The month is written out as Febr.; the day is a single 9 with the long descender this hand gives it, and the year 09 repeats the same 9. Fritz is the hand already known from this corpus."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
