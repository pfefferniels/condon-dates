         "belief": {
          "@type": "belief",
          "@id": "copies/rg931dy5023#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/rg931dy5023#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, treble edge, near the tail of the roll. Five figures, no separators, split 3 + 2 by spacing. The 1 is a plain caret, the 9 a closed bowl with a descender matching the 9 of the roll number, the 4 the looped form this hand uses in the number. The last figure is a closed double loop, both lobes inked on the left, so an 8 and not the open-left 3; if it were a 3 the year would be 23. Crop 1 holds only an ink blot; the roll number 2944 is written at the head of the roll (crop 3)."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
