        "text": "22922  [flourished monogram]",
        "@annotation": {
         "@id": "copies/qc650tp0469#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/qc650tp0469#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/qc650tp0469#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, read from the lower (180-degree) panel. Five figures run together without separators, 22 9 22; the middle figure has a closed bowl and a descender and is a 9, the other four are the same cursive 2. Further along the same line stands a single large flourished capital with a long descending loop, the puncher's mark; its head runs off the edge of the paper and I would not name the letter."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/qc650tp0469%2Fqc650tp0469_0001/",
