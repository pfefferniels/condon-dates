        "text": "30420.",
        "@annotation": {
         "@id": "copies/yr522jf5585#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/yr522jf5585#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/yr522jf5585#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Crop 1, lower panel upright; ink, strongly slanted, nothing else written in the crop. Five figures run together, closed by a full stop: 3 0 4 2 0. The second and fifth are the same narrow slanted oval, which fixes both as 0; the 4 is plain; the 2 is the softest figure. Read as day-month-year, 30.4.20. A 31 for the day is excluded by the shape and by April having 30 days."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/yr522jf5585%2Fyr522jf5585_0001/",
