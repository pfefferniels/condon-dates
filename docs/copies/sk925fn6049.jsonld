          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/sk925fn6049#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Crop 1, lower panel upright; pencil, one line, no name. Six figures in two groups, 11 and 1019: three 1s sharing the same flag, a narrow closed 0, and a 9 with a round head and a descender below the line. Read as 11.10.19."
           }
          ]
         }
        }
       }
      }
     ]
    }
