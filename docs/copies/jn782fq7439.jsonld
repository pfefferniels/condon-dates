      "@id": "copies/jn782fq7439.jsonld#date-annotation",
      "belief": {
       "@type": "belief",
       "@id": "copies/jn782fq7439.jsonld#date-belief",
       "certainty": "likely",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/jn782fq7439.jsonld#inscription-text"
         ],
         "note": "Pencil, one line. A cursive word of five or six letters stands before the date and is illegible to me; it may begin Hoff-. The day's second figure is an 8 written as two strokes converging on a single bottom bowl, so the upper loop is open; 6 can be ruled out because two strokes descend into the bowl. A three-figure group, perhaps 134, preceded by a letter, follows the date; I could not read it with confidence and have left roll_number empty."
        }
       ]
      }
     }
    },
