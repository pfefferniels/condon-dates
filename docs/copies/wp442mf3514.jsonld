       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/wp442mf3514.jsonld#inscription-text"
         ],
         "note": "Ink, a wide line with the number at the left, the date in the middle and Krämer at the right, Wössler written under Krämer on a second line. The day and month are plain, the year is two separate 1 strokes of the same form as the 1 in the number. The number stands as 12/16, the third stroke being a long slash with no entry hook, so it is not simply 1216."
        }
       ]
      }
     }
    },
