          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/dc661yr7679#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, written along the roll rather than across it, so the crop has to be turned a quarter turn. A four-figure number, then three groups of two plain strokes separated by points: 11.11.11. The date is unambiguous; of the number only the opening 10 is clear, the last two figures I cannot settle, so I have left roll_number empty"
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ]
    }
   ],
