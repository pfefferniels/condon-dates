       "transcription": {
        "@type": "text",
        "@id": "copies/zb497jz4405#inscription-text",
        "text": "28. 10 04  Hofmann",
        "@annotation": {
         "@id": "copies/zb497jz4405#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/zb497jz4405#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/zb497jz4405#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Ink, a heavier and more upright hand than the others in this batch. Day 28 and month 10 are plain. The year's second figure is the doubtful one: an arm descends from the upper left and meets the stem at mid height, which reads as the open form of 4 rather than 7, since in 7 the stem would leave the bar at its right end. 1907 cannot be excluded. The name reads Hofmann; Hohmann is possible."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
     "actor": {
      "name": "Hofmann",
      "sameAs": [],
