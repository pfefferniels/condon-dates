      "belief": {
       "@type": "belief",
       "@id": "copies/wj488tq5861.jsonld#date-belief",
       "certainty": "likely",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/wj488tq5861.jsonld#inscription-text"
         ],
         "note": "Fine pencil, one line on the upper (upright) panel, no roll number. The month 6 and the year 09 are plain. The day is two identical glyphs run together, each a curve over the top and a diagonal down to a curled base, which I read as 22; a reading of 77 would fit the strokes less well, since this hand crosses its sevens. The name is written fast but has the same shape as the Hohmüller on gs573tj9547 in this batch, which is how I read it here."
        }
       ]
      }
     }
    },
