       "transcription": {
        "@type": "text",
        "@id": "copies/bf644yy6536#inscription-text",
        "text": "1450.  11.[2 or 3].14.",
        "@annotation": {
         "@id": "copies/bf644yy6536#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/bf644yy6536#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/bf644yy6536#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Crop 1, lower panel upright, pencil, one line in two groups; crop 2 is a torn roll end with no writing. The writing sits hard against the top edge of the crop, so the upper third of every figure is cut off, in both panels alike. Group 1 reads 1450. and is taken as the roll number. Group 2 is 11 . X . 14 .: the day 11 and the year 14 are firm, the month figure is a thick stroke with a base sweeping right, either a 2 or a 3, and the clipped top is exactly what would tell them apart. Day and year alone give 1914; the month is left open rather than guessed."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/bf644yy6536%2Fbf644yy6536_0001/",
