        "@id": "copies/cp145vd3423#inscription-text",
        "text": "1382.  20. 1. 07.  [cursive signature, not read]",
        "@annotation": {
         "@id": "copies/cp145vd3423#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/cp145vd3423#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/cp145vd3423#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, fine cursive across the scanner's lines, upper panel upright. Same hand, layout and signature as rp146dk0477 (1352, 4.3.07) in this batch. Day and month are plain; the year is a small 0 run into a crossed 7, which is why the reading is not called high. The signature of roughly eight letters after the date I could not read."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ],
