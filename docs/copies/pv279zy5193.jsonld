       "transcription": {
        "@type": "text",
        "@id": "copies/pv279zy5193#inscription-text",
        "text": "1505    28.  6.12   Hohn: / W[...]",
        "@annotation": {
         "@id": "copies/pv279zy5193#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/pv279zy5193#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/pv279zy5193#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Crop 1, upper panel upright; ink, two lines. The month is the open-topped form that reading.md warns can be an 8, but the 8 in the day 28 on the same line is drawn with two closed bowls and looks nothing like it, so the month is a 6. The name beside the date is H-o-then three downstrokes: Hohn as written here, though the same strokes would also carry Holm, which German cursive does not distinguish. The second line is another name beginning with W, with a bar over its middle letters; I cannot resolve it and have not guessed."
           }
          ]
         }
        }
       }
      }
     ],
     "actor": {
      "name": "Hohnrieder",
      "sameAs": [],
      "@id": "hands#hohnrieder",
