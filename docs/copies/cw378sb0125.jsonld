          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/cw378sb0125#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil on dark red paper, five figures run together under the paper edge, both panels agree. The 5, the 2 and the last figure, a slanted oval crossed by a stroke and so a 0, are plain. The third figure has a longer top stroke than the second and taken alone could be a 7, but 5.17.20 is no month and 51.7.20 no day, so the only parse is 5.11.20."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
