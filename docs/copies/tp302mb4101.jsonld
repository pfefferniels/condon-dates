    "date": {
     "after": "1908-10-01",
     "before": "1908-10-31",
     "@annotation": {
      "@id": "copies/tp302mb4101.jsonld#date-annotation",
      "belief": {
       "@type": "belief",
       "@id": "copies/tp302mb4101.jsonld#date-belief",
       "certainty": "possible",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/tp302mb4101.jsonld#inscription-text"
         ],
         "note": "Pencil, upper panel upright, small and rubbed. Six figures in three pairs followed by a flourished signature I could not resolve. The month 10 and the year 08 I read with reasonable confidence; the first pair is muddied past the resolution of the scan and looks like 19, but I will not vouch for the day, so date_iso gives only the month. A quite separate later hand, in English pencil across crop 3, notes the roll's condition, is signed D. F. C. and dated 1985, and there says the roll is \"dated ... 10. 1908\"; that is an archive note, not the workshop, and I did not use it to settle the figures above. Crops 2 and 4 are blank."
        }
       ]
      }
     }
    },
