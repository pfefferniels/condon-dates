     "@annotation": {
      "@id": "copies/jv484vp9065.jsonld#date-annotation",
      "belief": {
       "@type": "belief",
       "@id": "copies/jv484vp9065.jsonld#date-belief",
       "certainty": "possible",
       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/jv484vp9065.jsonld#inscription-text"
         ],
         "note": "Ink, one line: a cursive word of five or six letters that I cannot letter out, then five figures with no separators, then an abbreviated No with four figures. The five figures read 2 0 2 0 4, so 20.2.04 on the corpus convention. Two reservations. The second figure is a closed oval with a short stroke rising from its upper left, so it could be a 6 rather than a 0, which would give 26.2.04. And the trailing number, which I read as 1248 though its middle figures are not firm, would sit oddly with 1904: another roll in this batch carries the printed label No. 1247 with a punch date of 1914. I record what the paper gives and leave that tension standing. Crop 2 is blank paper."
        }
       ]
      }
     }
    },
