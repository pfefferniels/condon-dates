         "belief": {
          "@type": "belief",
          "@id": "copies/fn111kx0654#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/fn111kx0654#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, one line along the roll edge, read after a contrast stretch. Figures of 1213 and of the 4 and 12 are plain. The day figure is the open-loop form: a lower bowl with a broad upper arch hooked to the right, so 8 rather than 6, but that one figure is of the ambiguous kind the instruction warns of."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
