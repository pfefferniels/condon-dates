         "belief": {
          "@type": "belief",
          "@id": "copies/cs175wr2428#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/cs175wr2428#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. A six-figure stamp set in a line along the roll, read as 1 9 1 1 2 6; the last figure is heavily inked but reads as 6 rather than 8 or 0. Taken as 19.11.26 on the day-first convention, but the grouping is my inference and the string would also sit as a number, so the date is not secure. Crop 3 carries an unrelated later note in English pencil, signed and dated '4.9.1987  D.C.', about the last part of the roll being tracked by hand; crop 2 shows a tear."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
