          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/nw765mr4994#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Ink stamp across the roll; the first digit of the day is buried under a heavy ink blot, so the day could be 14, 24 or 4, while 11 and 24 are plain. Roll number 3790 written in pencil in crop 2; crop 3 gives the box label, WELTE-MIGNON No. 3790, 'British Folkmusic, Settings Nr. 4, Shepherd's Hey', Percy Grainger, played by John Hare"
           }
          ]
         }
        }
       }
      }
     ]
    }
