          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/mh255vw4599#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, one line above a row of perforations; the month is written out as Novb. The figures of the roll number are fainter than the date, the reading 1236 is the best I can make of them."
           }
          ]
         }
        }
       },
