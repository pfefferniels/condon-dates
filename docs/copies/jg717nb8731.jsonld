        "@id": "copies/jg717nb8731#hand-belief",
        "certainty": "likely",
        "reasons": [
         {
          "@type": "meaningComprehension",
          "comprehends": [
           "copies/jg717nb8731#inscription-text"
          ],
          "note": "Read as \"Sph.; Wössler\". Countersigned by Wissler (https://w3id.org/condon-rolls/hands#wissler); an act has one actor in linked-rolls, so the countersignature is stated here only."
         },
         {
          "@type": "inference",
          "premises": [],
          "used": [
           "https://w3id.org/condon-rolls/hands"
          ],
          "note": "The signature is clustered with the hand's other rolls by comparing the inscription images, not by the name read."
         }
