       "transcription": {
        "@type": "text",
        "@id": "copies/jg717nb8731#inscription-text",
        "text": "2713  18.12.13  Sph. / Wössler Sph.",
        "@annotation": {
         "@id": "copies/jg717nb8731#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/jg717nb8731#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/jg717nb8731#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, two lines, plain in the upper panel of crop 1. The 8 in the day is the two-stroke form the instruction warns of, two strokes converging on one bottom bowl, but the 1 beside it and the 12 and 13 that follow leave the reading firm. The first figure of the number is a 2 with a looped top, settled by its horizontal base; the second is a 7 with a long descender. The name reads Wössler, though the vowel after the W is compressed and the umlaut is not distinct."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
     "actor": {
      "name": "Sph.",
      "sameAs": [],
      "@id": "hands#sph",
      "@annotation": {
