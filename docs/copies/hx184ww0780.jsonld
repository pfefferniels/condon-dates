          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/hx184ww0780#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Stamped, not written; small bracket marks flank the figures and the right one is over-inked into a blob, so a further figure there cannot be wholly excluded. Read as 28.1.25 on the pattern of the identically stamped 27125 on sw740gd4329. Region 5 is the printed leader label (Welte-Mignon No. 10, The harmonious Blacksmith, Handel)."
           }
          ]
         }
        }
       }
      }
     ]
    }
