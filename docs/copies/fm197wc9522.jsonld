         "belief": {
          "@type": "belief",
          "@id": "copies/fm197wc9522#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/fm197wc9522#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Stamped, not written, on pale buff paper; the upper panel is the upright one. Five figures, each plain, with no separators, read as 14.1.25 on the pattern of 14114 for 14.1.1914. A sixth impression to the right is doubled and blotted, and I cannot make anything of it."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
