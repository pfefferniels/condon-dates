       "transcription": {
        "@type": "text",
        "@id": "copies/ps108fn1431#inscription-text",
        "text": "N. 1288  7.1.09  [signature]",
        "@annotation": {
         "@id": "copies/ps108fn1431#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/ps108fn1431#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/ps108fn1431#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, one line, upper panel upright. The day is a crossed 7; the year 09 matches the 9 written with a descender. The roll number ends in two of the open-topped 8s described in reading.md; its second figure sits on the baseline without a descender, so I read 2 rather than 9. A short signature of some four letters follows the date, beginning with a looped capital and ending in a long descender; I could not resolve it into a name."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ],
     "actor": {
      "name": "Kopf",
      "sameAs": [],
