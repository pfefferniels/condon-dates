        "text": "24. 4. 14. Smith.",
        "@annotation": {
         "@id": "copies/pz175wg5571#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/pz175wg5571#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/pz175wg5571#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, a single line read from the lower panel. The three 4s are written alike, as an open 4, which settles the month and the year against 9. The name is read as Smith, the t and h sharing one long crossbar; Smits or Smitz would also fit the final letter."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
