        "text": "1184   3. 8. 10   Roth / [second hand, illegible]",
        "@annotation": {
         "@id": "copies/zw485gh6070#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/zw485gh6070#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/zw485gh6070#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, large and unhurried, on clear paper. Third figure of the number is the open-topped 8 of these hands, not a 6; the 8 of the date is a closed figure-eight. A second short signature sits below and right of Roth, four or five cursive letters, which I cannot letter out with any confidence."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
