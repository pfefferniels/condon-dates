         "belief": {
          "@type": "belief",
          "@id": "copies/hy749gh2331#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/hy749gh2331#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Crop 1, lower panel upright; pencil, five figures run together with no separators, read as 24.2.22. Figures 1, 3, 4 and 5 are the same 2, drawn with a top curl and a base sweeping right. Figure 2 is the arguable one: two arms meeting at a point with a single stem running well below the baseline. I take it for a 4; a crossed 7 would give 27.2.22, but a 7 in these hands sits on the line and is cut by a bar at mid height, and this glyph has neither. Crop 2 carries a separate small ink initial with a stop, not a date."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/hy749gh2331%2Fhy749gh2331_0001/",
