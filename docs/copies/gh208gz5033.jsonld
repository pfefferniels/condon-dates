       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/gh208gz5033.jsonld#inscription-text"
         ],
         "note": "Pencil on ruled paper, one line, upper panel upright. Roll number 763 and the name Fritz are plain, as are the day 18 and the year 1908. The month is written as a word abbreviated to about five letters; the initial capital reads to me as D (Dezbr, December), but a capital O (Octbr, October) cannot be ruled out from this crop, and the middle letters are indistinct. Region 2 of this roll carries perforations only, no writing."
        }
       ]
      }
     }
    },
