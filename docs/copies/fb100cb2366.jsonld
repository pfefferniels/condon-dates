       "transcription": {
        "@type": "text",
        "@id": "copies/fb100cb2366#inscription-text",
        "text": "27. 4. 17.",
        "@annotation": {
         "@id": "copies/fb100cb2366#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/fb100cb2366#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/fb100cb2366#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, treble edge, at the tail of the roll just past the last hole. Both 7s are the barred continental form (upstroke, long diagonal down-left, crossbar); the 1 before the second 7 is a plain caret with no crossbar, so 17 and not 11 or 77. The 4 is the open-top form. The crop clips the very tops of the figures at the panel edge, but the crossbars and diagonals are complete. The roll number 2948. is written separately at the head of the roll (region 2), in what looks like the same hand; its last figure is the open-loop form that can read as 6. Region 4, on the leader, carries a later note in English cursive about the roll's condition (\"... especially bass + treble ... over the ... election. ... bite -\"), a different and later hand with no date. Region 3 is a stain."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/fb100cb2366%2Ffb100cb2366_0001/",
