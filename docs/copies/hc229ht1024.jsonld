        "text": "7 10-24",
        "@annotation": {
         "@id": "copies/hc229ht1024#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/hc229ht1024#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/hc229ht1024#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Stamped, not written, in black on the bare red paper; the impression is uneven. The figures 7, 1, 0 and 2, 4 are plain, with a hyphen between the 0 and the 2, read 7.10.24. A small broken mark stands a digit's width to the left of the 7 and matching marks and a short vertical rule stand at the right end, which I take for the stamp's frame rather than figures; if the left mark were a weakly struck figure the day would be 17 instead of 7."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
