        "text": "1447  6 5 09  [short name, not read]",
        "@annotation": {
         "@id": "copies/kg488qt3887#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/kg488qt3887#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/kg488qt3887#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, upper panel upright, no separators between the date figures. The 6 has a single bowl and a curved ascender, the 5 is the two-stroke form with its top bar written separately, and 09 is plain. In the roll number the fourth figure is not shaped like the leading 1: it reads most nearly as 7, though 9 cannot be excluded. A short surname follows the date, apparently beginning May- and ending in three minims; I could not read it with confidence."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
