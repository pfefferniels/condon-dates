         "belief": {
          "@type": "belief",
          "@id": "copies/yr287jf4422#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/yr287jf4422#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil. A short word, written twice one line above the other, stands before the date; it begins with M or W and seems to carry an umlaut, but I cannot read it. The 4 is the closed-triangle form; the final 8 has a narrow slanted upper loop over a full bowl. Same hand and same date as yg150mb0559, where the year is written more clearly."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ],
