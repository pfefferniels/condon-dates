       "transcription": {
        "@type": "text",
        "@id": "copies/sc188ff2842#inscription-text",
        "text": "1260    21. 7. 11    Krämer / Wössler",
        "@annotation": {
         "@id": "copies/sc188ff2842#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/sc188ff2842#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/sc188ff2842#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, the number at the left, the date in the middle, Krämer at the right with the umlaut stroke plain and Wössler written under it. The same two names and the same hand as wp442mf3514 in batch 14, which carries 25. 4. 11. The month figure is the crossbarred 7 of this hand, not the H-shaped 4 it writes elsewhere, and the year is two separate 1 strokes."
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
