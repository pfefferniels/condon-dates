       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/ps751km7125.jsonld#inscription-text"
         ],
         "note": "Ink on ruled red paper, upper panel upright, two lines. The first gives the roll number 819, then the date in three groups separated by points, then the name Roth, all of it plain. The second line is a second name written below Roth, a capital W with a small raised letter or suspension stroke after it and then mbr; I cannot resolve it further and give it as Wmbr. The ruled lines across the paper are printed, not creases."
        }
       ]
      }
     }
