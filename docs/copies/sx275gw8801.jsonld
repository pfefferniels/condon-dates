         "belief": {
          "@type": "belief",
          "@id": "copies/sx275gw8801#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/sx275gw8801#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Stamped or inked, no separators; four evenly spaced figures, the last with two closed counters so an 8, not a 6. Parsed 1.4.28 on the two-digit-year convention of the other rolls, but 14.2.8 is possible. Two illegible strokes and a comma-like mark stand to the left of the figures. Crop 3 carries a faint pencil number, perhaps 332 4, and crops 2-3 a long pencil line; neither is a date."
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
