        "text": "7?14",
        "@annotation": {
         "@id": "copies/hs635sh6729#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/hs635sh6729#transcription-belief",
          "certainty": "possible",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/hs635sh6729#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Pencil, read from the lower (180-degree) panel and checked against the upper one. Four figures run together without separators, close to the edge of the paper, which clips their heads. The first is a crossed 7 and the last two are 14, so the day is 7 and the year 1914. The second figure has a closed bowl at the foot with two strokes converging on it and the upper loop left open: that is the 8 described in the reading notes, but a 3 or a 5 would sit in the same space and I cannot settle it, so the month is left open."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/hs635sh6729%2Fhs635sh6729_0001/",
