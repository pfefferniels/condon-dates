       "transcription": {
        "@type": "text",
        "@id": "copies/xm993qd2681#inscription-text",
        "text": "1247,  24, 2, 14,",
        "@annotation": {
         "@id": "copies/xm993qd2681#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/xm993qd2681#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/xm993qd2681#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, one steeply slanted line, read after deshearing and a contrast stretch; the separators are low commas rather than dots. The hand's figures were fixed from within the same line: crop 2 carries the printed leader label 'WELTE-MIGNON No. 1247 Sonata C sharp minor (Moonlight) Part 3, L. v. Beethoven', and the pencil number agrees with it, which gives a 2, a 4 and a 7 to compare against. The day's two figures then match that 2 and 4, the month matches the 2, and the year is the plain 1 of the number followed by the same 4. The 4 and 7 of this hand are close, so the reading rests on that comparison rather than on the figures alone."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/xm993qd2681%2Fxm993qd2681_0001/",
