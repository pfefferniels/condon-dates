        "reasons": [
         {
          "@type": "meaningComprehension",
          "comprehends": [
           "copies/bp952tr1116#inscription-text"
          ],
          "note": "Read as \"Kummer\". Countersigned by Wissler (https://w3id.org/condon-rolls/hands#wissler); an act has one actor in linked-rolls, so the countersignature is stated here only."
         },
         {
          "@type": "inference",
          "premises": [],
          "used": [
           "https://w3id.org/condon-rolls/hands"
          ],
          "note": "The signature is clustered with the hand's other rolls by comparing the inscription images, not by the name read."
         }
        ]
