       "transcription": {
        "@type": "text",
        "@id": "copies/bp952tr1116#inscription-text",
        "text": "699  19. 4. 10  Kumer (overbar on the m) / [second signature, illegible]",
        "@annotation": {
         "@id": "copies/bp952tr1116#transcription-annotation",
         "belief": {
          "@type": "belief",
          "@id": "copies/bp952tr1116#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/bp952tr1116#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Ink, two lines; the first name is written Kumer with an overbar over the m, so Kummer. A second cursive signature on the line below is not legible to me; it may be the Woessler hand seen elsewhere in the corpus, but I cannot make it out. The roll number's first figure is a single downstroke into a closed bowl, so 6 rather than 8; the two following figures match the 9 of 19 in the date"
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ],
     "actor": {
      "name": "Kummer",
      "sameAs": [],
      "@id": "hands#kummer",
      "@annotation": {
