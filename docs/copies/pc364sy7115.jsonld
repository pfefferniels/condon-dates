       "reasons": [
        {
         "@type": "meaningComprehension",
         "comprehends": [
          "copies/pc364sy7115.jsonld#inscription-text"
         ],
         "note": "pencil, written along the roll; read from the upper panel rotated a quarter turn. Day and month plain: both 9s are a small closed bowl over a straight descender, no apex or crossbar, so 19.9 and not 14.4. The year pair is thinner and slightly rubbed, but the second figure carries a horizontal top bar, hence 17. The fourth figure of the number descends below the line, so 2609 and not 2600."
        }
       ]
      }
     }
    },
