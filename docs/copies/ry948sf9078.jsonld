         "belief": {
          "@type": "belief",
          "@id": "copies/ry948sf9078#transcription-belief",
          "certainty": "likely",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/ry948sf9078#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Pencil, along the roll; four figures run together without separators, a crossed German 7 followed by three cursive 2s, so 7.2.22. All four figures are plain; the grouping into day, month and year follows the convention, no separators are written. The roll number comes from crop 1, which carries '110' in pencil and nothing else. No name with either."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
     ]
    }
   ],
