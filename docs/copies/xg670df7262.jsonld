          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/xg670df7262#inscription"
            ],
            "note": "Graded medium on the figures of the date: one figure is arguable. Ink, one line, no number and no name; heavily slanted, read after deslanting. Month is the two-stroke 8 of this hand. The year's first figure is an open arch, so 1 rather than 0, and its second figure has the same closed loop and descender as the 9 of the day"
           }
          ]
         }
        }
       },
       "medium": "ink"
      }
     ]
    }
