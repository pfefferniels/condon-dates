          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/rq927dq9061#inscription"
            ],
            "note": "Graded low on the figures of the date: the figures could give another date. Pencil on red paper, four figures, no separators, read as 8.6.26. The first figure is a two-loop 8. The second and fourth are the open-top form that reading.md warns can be 6 or 8; I take them for 6 because this hand writes 8 with two closed loops, but 8.8.28 cannot be ruled out. The third is a plain 2"
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
