            "comprehends": [
             "copies/jm300wy4714#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Pencil, plain. The month figure is the open-topped 8 described in reading.md, two strokes converging on a bottom bowl, not a 6. No puncher's name in the crop."
           }
          ]
         }
        }
       },
       "medium": "pencil"
      }
