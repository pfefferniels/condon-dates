         "belief": {
          "@type": "belief",
          "@id": "copies/jt465zc6779#transcription-belief",
          "certainty": "true",
          "reasons": [
           {
            "@type": "meaningComprehension",
            "comprehends": [
             "copies/jt465zc6779#inscription"
            ],
            "note": "Graded high on the figures of the date: every figure is plain. Stamped, with a heavy blob before the figures and a second ornament after them, both part of the slug; the figures alone give 1.3.25, so I have not read the leading blob as a 1. The four figures are crisp. The roll number is from the printed title label on the leader in e3, 'WELTE-MIGNON No. 5658 / Driftwood / Fox-trot / Lew Gold / Played by Ed. Johnson', with a rights slip of M. Welte & Söhne, Freiburg i. Br. — printed, not a written hand. e2, e4 and e5 are blank"
           }
          ]
         }
        }
       }
      }
     ]
    }
   ],
   "scan": "https://stacks.stanford.edu/image/iiif/jt465zc6779%2Fjt465zc6779_0001/",
