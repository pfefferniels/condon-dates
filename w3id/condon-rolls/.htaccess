# The red Welte rolls of the Condon collection at Stanford, as linked data.
# Each IRI names a JSON-LD document without its extension, and the fragments
# of it name what the document states: copies/mf320jq4997#copy is the roll,
# copies/mf320jq4997#date-belief the belief in its punch date. The documents
# are served from GitHub Pages; moving them means changing this file only.

Options +FollowSymLinks
RewriteEngine on

RewriteRule ^copies/([a-z]{2}[0-9]{3}[a-z]{2}[0-9]{4})$ https://pfefferniels.github.io/condon-dates/copies/$1.jsonld [R=302,L]
RewriteRule ^copies$ https://pfefferniels.github.io/condon-dates/copies.jsonld [R=302,L]
RewriteRule ^hands$ https://pfefferniels.github.io/condon-dates/hands.jsonld [R=302,L]
RewriteRule ^context\.jsonld$ https://pfefferniels.github.io/condon-dates/context.jsonld [R=302,L]
RewriteRule ^.*$ https://pfefferniels.github.io/condon-dates/ [R=302,L]
